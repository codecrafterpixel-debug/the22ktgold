{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,



  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "the22ktgold.in"
        }
      ],
      "destination": "https://www.the22ktgold.in/:path*",
      "permanent": true
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/collections",
      "destination": "/collections.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/custom",
      "destination": "/custom.html"
    },
    {
      "source": "/b2b",
      "destination": "/b2b.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/product-detail",
      "destination": "/product-detail.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/article",
      "destination": "/article.html"
    },
    {
      "source": "/admin-login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/super-admin",
      "destination": "/super-admin.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms-and-conditions.html"
    },
    {
      "source": "/terms",
      "destination": "/terms-and-conditions.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
